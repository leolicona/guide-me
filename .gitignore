# Dependency directories
node_modules/

# Production builds
dist/
dist-server/
dist-ssr/

# Wrangler cache/build directory
.wrangler/
# Clone-wide local D1 replica: every worktree symlinks api-turistear/.wrangler here
# (api-turistear/scripts/local-db.mjs).
.wrangler-shared/
# The worktree-local state that db:migrate:local parks aside when it takes over the link.
.wrangler.worktree-local/

# Environment files
.env
.env.production
.dev.vars

# System logs & lock files
*.log
.DS_Store

# Antigravity CLI
.antigravitycli/
.playwright-cli/
.claude/
# Playwright e2e artifacts
app-turistear/e2e/.report/
app-turistear/test-results/
app-turistear/playwright-report/
app-turistear/e2e/.auth/
