# Local-only overrides for `pnpm dev` (git-ignored — see .gitignore:22).
# These take precedence over the `vars` block in wrangler.jsonc.
#
# Signing in locally needs no external service (passkey-auth FR-064): the sign-in code is printed in
# the API console (`[otp] <email> <code>`, OTP_LOG_TO_CONSOLE in wrangler.jsonc's local profile).

# THE COOKIE DOMAIN MUST BE EMPTY.
#    wrangler.jsonc sets `.turistearya.com`, and a browser refuses a cookie whose Domain does not
#    match the host it came from. On localhost the sign-in answers 200, the session cookie is
#    dropped on the floor, and the next request is a 401.
#    Empty ⇒ a host-only cookie on localhost.
COOKIE_DOMAIN=

# Local origins. `API_BASE_URL` is what portal links and QR codes are built from, so leaving it
# pointing at production would make a locally-created ticket resolve to the live site.
# `APP_BASE_URL` MUST stay http://localhost:5174: a llave de acceso belongs to the host of this URL
# (passkey-auth D8), so any other value makes the browser refuse every passkey ceremony locally.
API_BASE_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5174
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Signs the session cookie and encrypts the stored sign-in codes (passkey-auth D5, D7). Any 32+
# random characters work locally (`openssl rand -base64 48`). In dev and prod it is a Worker secret
# (`wrangler secret put BETTER_AUTH_SECRET --env …`), DIFFERENT in each environment, never committed.
# Changing it signs everyone out and voids pending codes; passkeys survive it.
BETTER_AUTH_SECRET=

# HMAC secret for QR tokens and operator shift sessions. Any value works locally; it only has to be
# stable, or previously-issued local QRs stop verifying.
QR_SECRET=change-me-any-stable-local-value

# Deliberately invalid: nothing local should be sending real email. Any endpoint that tries
# (invites, tickets, cancellation notices) will fail with a 502 from Resend — that is the intended
# signal, not a misconfiguration. Sign-in codes never reach Resend locally: they go to the console.
RESEND_API_KEY=local-dev-no-email
RESEND_FROM=no-reply@localhost
