{
  "$schema": "node_modules/wrangler/config-schema.json",
  // ─────────────────────────────────────────────────────────────────────────────
  // Multi-environment config, resolved by @cloudflare/vite-plugin at BUILD time via the
  // CLOUDFLARE_ENV variable (NOT `wrangler deploy --env`, which the plugin's build-output
  // config ignores). The package scripts set it:
  //   pnpm deploy:api:dev   → CLOUDFLARE_ENV=dev        (api-guideme-dev · api-dev.turistearya.com · guideme-db)
  //   pnpm deploy:api:prod  → CLOUDFLARE_ENV=production (api-guideme     · api.turistearya.com     · guideme-db-prod)
  //   preview.yml           → CLOUDFLARE_ENV=preview    (api-guideme-pr-<n> · workers.dev       · guideme-db)
  // D1 migrations bypass vite, so THEY use `--env` directly (pnpm db:migrate:dev|prod).
  //
  // The TOP LEVEL is the LOCAL profile only (`vite dev`); its fallback name
  // `api-guideme-local` keeps a stray `wrangler deploy` (CLOUDFLARE_ENV unset) OFF the
  // prod worker. Named envs do NOT inherit `vars`, `d1_databases`, `services`, `routes`,
  // or `triggers` — each restates them IN FULL; `main`, `compatibility_date`,
  // `compatibility_flags` ARE inherited.
  //
  // Deployed worker names are kept from the GuideMe era: renaming the production worker
  // would orphan its custom domain, secrets, and D1 binding.
  // ─────────────────────────────────────────────────────────────────────────────
  "name": "api-guideme-local",
  "compatibility_date": "2025-08-03",
  // passkey-auth D3 (R15) — Better Auth needs Node built-ins at runtime: AsyncLocalStorage
  // (`node:async_hooks`) for its request context, and `node:crypto`, which @better-auth/utils
  // resolves for the `workerd` condition. `nodejs_compat` is what Better Auth documents for
  // Workers. Inherited by the named envs.
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/index.tsx",

  // Local (`vite dev`) bindings + vars. Secrets come from `.dev.vars`. Migrations run
  // against the local SQLite replica via `pnpm db:migrate:local`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guideme-db",
      "database_id": "15cd8f75-c94e-41e8-9ec0-d43b1cf73a04",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "COOKIE_DOMAIN": ".turistearya.com",
    "CORS_ORIGIN": "http://localhost:5173,https://app.turistearya.com",
    "API_BASE_URL": "https://api.turistearya.com",
    "APP_BASE_URL": "https://app.turistearya.com",
    "RESEND_FROM": "no-reply@turistearya.com",
    // passkey-auth D5 — the session cookie is `__Secure-<prefix>.session_token`. Each
    // environment has its own prefix: dev and prod both set cookies on `.turistearya.com`,
    // so a shared name would let one overwrite the other's session.
    "AUTH_COOKIE_PREFIX": "gm-local",
    // passkey-auth D7, FR-064 — LOCAL ONLY: print sign-in codes in the API console instead
    // of emailing them. Never set it in `env.dev` or `env.production`.
    "OTP_LOG_TO_CONSOLE": "true",
    // devolada-transfer-verification D17 — Devolada's collections API. Test credentials
    // everywhere but production (DEVOLADA_KEY_MODE, the mode policy of D2). The notification
    // address is empty here: a laptop's API_BASE_URL points at production, so Devolada must
    // not deliver to it, and verdicts arrive through the sweep. The secret
    // DEVOLADA_CREDENTIAL_KEY comes from `.dev.vars`.
    "DEVOLADA_API_BASE_URL": "https://api.devoladapago.com",
    "DEVOLADA_KEY_MODE": "test",
    "DEVOLADA_WEBHOOK_URL": ""
  },

  "env": {
    // ─── DEV ─── api-guideme-dev · api-dev.turistearya.com · guideme-db-dev ───────
    "dev": {
      "name": "api-guideme-dev",
      "routes": [
        {
          "pattern": "api-dev.turistearya.com",
          "custom_domain": true
        }
      ],
      // US-AG07 (P3) — auto-cancel expired bookings every 15 min (against the dev DB).
      "triggers": {
        "crons": ["*/15 * * * *"]
      },
      // Dev intentionally reuses the ORIGINAL guideme-db — its pre-split data was all
      // dev/test, so it becomes the dev environment's realistic dataset. Prod starts empty
      // on guideme-db-prod (below).
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "guideme-db",
          "database_id": "15cd8f75-c94e-41e8-9ec0-d43b1cf73a04",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "COOKIE_DOMAIN": ".turistearya.com",
        "CORS_ORIGIN": "http://localhost:5173,https://app-dev.turistearya.com",
        "API_BASE_URL": "https://api-dev.turistearya.com",
        "APP_BASE_URL": "https://app-dev.turistearya.com",
        "RESEND_FROM": "no-reply@turistearya.com",
        "AUTH_COOKIE_PREFIX": "gm-dev",
        // devolada-transfer-verification D17 — test credentials; Devolada notifies this Worker.
        "DEVOLADA_API_BASE_URL": "https://api.devoladapago.com",
        "DEVOLADA_KEY_MODE": "test",
        "DEVOLADA_WEBHOOK_URL": "https://api-dev.turistearya.com/api/webhooks/devolada"
      }
    },

    // ─── PREVIEW ─── api-guideme-pr-<n> · <n>.workers.dev · guideme-db (dev's data) ───
    // One per pull request (delivery-pipeline D2). preview.yml deploys it with
    // `--name api-guideme-pr-<n>` and sets the three origins with `--var`, because they
    // carry the pull request number; the empty values below fail closed (CORS admits
    // nobody) if a deploy ever forgets them. No `routes`, so a preview can never claim
    // api-dev or api; no `triggers`, because dev's own sweep already covers the shared
    // database (D3). `COOKIE_DOMAIN` is empty, so the session cookie is host-only on the
    // preview's API — workers.dev is a public suffix, so the preview's app is the same
    // site and the cookie still reaches the API (D4).
    "preview": {
      "name": "api-guideme-preview",
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "guideme-db",
          "database_id": "15cd8f75-c94e-41e8-9ec0-d43b1cf73a04",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "COOKIE_DOMAIN": "",
        "CORS_ORIGIN": "",
        "API_BASE_URL": "",
        "APP_BASE_URL": "",
        "RESEND_FROM": "no-reply@turistearya.com",
        // passkey-auth D5 — its own cookie name. Host-only on the preview's API, so it never
        // meets dev's or prod's session cookie; `BETTER_AUTH_SECRET` comes from the GitHub `dev`
        // environment through preview.yml's secrets file (delivery-pipeline D5, research R2).
        "AUTH_COOKIE_PREFIX": "gm-preview",
        // devolada-transfer-verification D17 — test credentials and NO notification address: a
        // preview serves dev's database and runs no cron, so the business keeps dev's address and
        // dev follows the links a preview issues. DEVOLADA_CREDENTIAL_KEY is dev's value or none,
        // never a throwaway (preview.yml).
        "DEVOLADA_API_BASE_URL": "https://api.devoladapago.com",
        "DEVOLADA_KEY_MODE": "test",
        "DEVOLADA_WEBHOOK_URL": ""
      }
    },

    // ─── PRODUCTION ─── api-guideme · api.turistearya.com · guideme-db-prod ───────
    "production": {
      "name": "api-guideme",
      "routes": [
        {
          "pattern": "api.turistearya.com",
          "custom_domain": true
        }
      ],
      // US-AG07 (P3) — every 15 min, auto-cancel expired bookings and release their spots.
      "triggers": {
        "crons": ["*/15 * * * *"]
      },
      // Fresh, EMPTY database for the production launch (the original guideme-db, with its
      // dev/test data, moved to env.dev above).
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "guideme-db-prod",
          "database_id": "4f7e6b53-af6c-4c99-96e2-625f08b52c37",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "COOKIE_DOMAIN": ".turistearya.com",
        "CORS_ORIGIN": "http://localhost:5173,https://app.turistearya.com",
        "API_BASE_URL": "https://api.turistearya.com",
        "APP_BASE_URL": "https://app.turistearya.com",
        "RESEND_FROM": "no-reply@turistearya.com",
        "AUTH_COOKIE_PREFIX": "gm",
        // devolada-transfer-verification D17 — production takes only real credentials (D2).
        "DEVOLADA_API_BASE_URL": "https://api.devoladapago.com",
        "DEVOLADA_KEY_MODE": "real",
        "DEVOLADA_WEBHOOK_URL": "https://api.turistearya.com/api/webhooks/devolada"
      }
    }
  }
}
