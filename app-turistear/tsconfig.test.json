{
  /* The half of `src` that tsconfig.app.json excludes. Same compiler options as the app so a test
     cannot compile against looser rules than the code it covers — only the type surface differs
     (vitest globals are NOT declared: tests import describe/it/expect explicitly). */
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test"],
  "exclude": []
}
